#Область ПрограммныйИнтерфейс

// Формирует реализации по договорам абонентского обслуживания за указанный месяц.
// Выполняется в фоновом задании через механизм длительных операций БСП.
//
// Параметры:
//  Параметры       - Структура - параметры выполнения:
//   * Период       - Дата      - любая дата месяца, за который создаются акты.
//   * Договоры     - Массив из СправочникСсылка.ДоговорыКонтрагентов - обрабатываемые договоры.
//  АдресРезультата - Строка    - адрес во временном хранилище для помещения результата.
//
Процедура СоздатьАктыВФоне(Знач Параметры, АдресРезультата) Экспорт
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Договор");
	Результат.Колонки.Добавить("Реализация");
	Результат.Колонки.Добавить("Результат");
	
	Для Каждого Договор Из Параметры.Договоры Цикл
		
		СтрокаРезультата = Результат.Добавить();
		СтрокаРезультата.Договор = Договор;
		
		Существующая = РеализацияЗаМесяц(Договор, Параметры.Период);
		
		Если ЗначениеЗаполнено(Существующая) Тогда
			СтрокаРезультата.Реализация = Существующая;
			СтрокаРезультата.Результат = НСтр("ru = 'Реализация за месяц уже создана'");
			Продолжить;
		КонецЕсли;
		
		Попытка
			СтрокаРезультата.Реализация = СоздатьРеализацию(Договор, Параметры.Период);
			СтрокаРезультата.Результат = НСтр("ru = 'Создана и проведена'");
		Исключение
			СтрокаРезультата.Результат = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	
КонецПроцедуры

// Возвращает действующие в указанном месяце договоры абонентского обслуживания
// вместе с уже созданными за этот месяц реализациями.
//
// Параметры:
//  Период - Дата - любая дата месяца.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Договор, Клиент, Реализация.
//
Функция ДействующиеДоговоры(Знач Период) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Договоры.Ссылка КАК Договор,
		|	Договоры.Владелец КАК Клиент,
		|	Реализации.Ссылка КАК Реализация
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК Договоры
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК Реализации
		|		ПО Реализации.Договор = Договоры.Ссылка
		|			И Реализации.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|			И НЕ Реализации.ПометкаУдаления
		|ГДЕ
		|	Договоры.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание)
		|	И НЕ Договоры.ПометкаУдаления
		|	И Договоры.ВКМ_ДатаНачала <= &КонецПериода
		|	И Договоры.ВКМ_ДатаОкончания >= &НачалоПериода
		|УПОРЯДОЧИТЬ ПО
		|	Клиент,
		|	Договор";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(Период));
	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(Период));
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ищет непомеченную на удаление реализацию по договору за месяц.
//
// Параметры:
//  Договор - СправочникСсылка.ДоговорыКонтрагентов - договор абонентского обслуживания.
//  Период  - Дата - любая дата месяца.
//
// Возвращаемое значение:
//  ДокументСсылка.РеализацияТоваровУслуг - найденный документ или пустая ссылка.
//
Функция РеализацияЗаМесяц(Знач Договор, Знач Период)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Реализации.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК Реализации
		|ГДЕ
		|	Реализации.Договор = &Договор
		|	И Реализации.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И НЕ Реализации.ПометкаУдаления";
	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(Период));
	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(Период));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Документы.РеализацияТоваровУслуг.ПустаяСсылка());
	
КонецФункции

// Создает и проводит реализацию по договору за указанный месяц.
//
// Параметры:
//  Договор - СправочникСсылка.ДоговорыКонтрагентов - договор абонентского обслуживания.
//  Период  - Дата - любая дата месяца.
//
// Возвращаемое значение:
//  ДокументСсылка.РеализацияТоваровУслуг - созданный документ.
//
Функция СоздатьРеализацию(Знач Договор, Знач Период)
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "Владелец, Организация");
	
	Документ = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
	Документ.Дата = КонецМесяца(Период);
	Документ.Контрагент = РеквизитыДоговора.Владелец;
	Документ.Организация = РеквизитыДоговора.Организация;
	Документ.Договор = Договор;
	
	// Стандартный алгоритм заполнения документа.
	Документ.Заполнить(Неопределено);
	
	// Заполнение по условиям абонентского договора.
	Документ.ВКМ_ВыполнитьАвтозаполнение();
	
	// Стандартная проверка заполнения перед проведением.
	Если Не Документ.ПроверитьЗаполнение() Тогда
		ВызватьИсключение НСтр("ru = 'Документ не прошел проверку заполнения'");
	КонецЕсли;
	
	Документ.Записать(РежимЗаписиДокумента.Проведение);
	
	Возврат Документ.Ссылка;
	
КонецФункции

#КонецОбласти

#КонецЕсли
