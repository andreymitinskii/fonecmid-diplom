// Форма выбора даты для календаря специалистов.
//
// Показывает штатный календарь 1С, в котором подсвечены дни с заявками.
// Выбранная дата возвращается форме-владельцу через Закрыть().
//
// Обработчик ПриВыводеПериода не может обращаться к серверу, поэтому список
// дней с заявками получается один раз при открытии формы и хранится на клиенте.
&НаКлиенте
Перем ДатыСЗаявками;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если ЗначениеЗаполнено(Параметры.Дата) Тогда
		ВыбраннаяДата = НачалоДня(Параметры.Дата);
	Иначе
		ВыбраннаяДата = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Первый вывод периода происходит до открытия формы, поэтому после получения
	// списка дней календарь перерисовывается.
	ДатыСЗаявками = ДатыЗаявок();
	Элементы.ПолеКалендаря.Обновить();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Календарь выводит очередной месяц: подсвечиваем дни, на которые есть заявки.
//
// Параметры:
//  Элемент           - ПолеФормы         - поле календаря.
//  ОформлениеПериода - ОформлениеПериода - оформление выводимого периода.
//
&НаКлиенте
Процедура ПолеКалендаряПриВыводеПериода(Элемент, ОформлениеПериода)

	Если ТипЗнч(ДатыСЗаявками) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	ЦветДняСЗаявками = Новый Цвет(146, 208, 80);
	ШрифтДняСЗаявками = Новый Шрифт(, , Истина);

	Для Каждого ОформлениеДаты Из ОформлениеПериода.Даты Цикл

		КоличествоЗаявок = ДатыСЗаявками.Получить(НачалоДня(ОформлениеДаты.Дата));
		Если КоличествоЗаявок = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ОформлениеДаты.ЦветФона = ЦветДняСЗаявками;
		ОформлениеДаты.Шрифт = ШрифтДняСЗаявками;
		ОформлениеДаты.Подсказка = НСтр("ru = 'Заявок за день: '") + Формат(КоличествоЗаявок, "ЧН=0; ЧГ=0");

	КонецЦикла;

КонецПроцедуры

// Одиночный клик по дню: поле календаря меняет значение реквизита, этого
// достаточно, чтобы вернуть дату форме-владельцу.
//
&НаКлиенте
Процедура ПолеКалендаряПриИзменении(Элемент)

	Если ЗначениеЗаполнено(ВыбраннаяДата) Тогда
		Закрыть(НачалоДня(ВыбраннаяДата));
	КонецЕсли;

КонецПроцедуры

// Выбор даты: возвращаем дату форме-владельцу.
//
// Первым параметром обработчик события управляемой формы получает сам элемент
// формы, поэтому выбранная дата приходит вторым параметром.
//
&НаКлиенте
Процедура ПолеКалендаряВыбор(Элемент, ДатаКалендаря = Неопределено, СтандартнаяОбработка = Неопределено)

	Дата = ?(ТипЗнч(ДатаКалендаря) = Тип("Дата"), ДатаКалендаря,
		?(ТипЗнч(Элемент) = Тип("Дата"), Элемент, Неопределено));

	Если Дата = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Закрыть(НачалоДня(Дата));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает дни, на которые есть заявки, с количеством заявок за день.
//
// Возвращаемое значение:
//  Соответствие - ключ Дата (начало дня), значение Число.
//
&НаСервереБезКонтекста
Функция ДатыЗаявок()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(Обслуживание.ДатаПроведенияРабот, ДЕНЬ) КАК ДеньРабот,
		|	КОЛИЧЕСТВО(Обслуживание.Ссылка) КАК КоличествоЗаявок
		|ИЗ
		|	Документ.ВКМ_ОбслуживаниеКлиента КАК Обслуживание
		|ГДЕ
		|	НЕ Обслуживание.ПометкаУдаления
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(Обслуживание.ДатаПроведенияРабот, ДЕНЬ)";

	Даты = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Даты.Вставить(Выборка.ДеньРабот, Выборка.КоличествоЗаявок);
	КонецЦикла;

	Возврат Даты;

КонецФункции

#КонецОбласти
