#Область ПрограммныйИнтерфейс

// Возвращает ставку налога на доходы физических лиц.
//
// Возвращаемое значение:
//  Число - ставка НДФЛ в процентах.
//
Функция СтавкаНДФЛ() Экспорт
	
	Возврат 13;
	
КонецФункции

// Рассчитывает сумму НДФЛ от суммы начислений.
//
// Параметры:
//  СуммаНачислений - Число - облагаемая сумма начислений.
//
// Возвращаемое значение:
//  Число - сумма удержания, округленная до копеек.
//
Функция РассчитатьНДФЛ(СуммаНачислений) Экспорт
	
	Возврат Окр(СуммаНачислений * СтавкаНДФЛ() / 100, 2);
	
КонецФункции

// Возвращает количество рабочих дней в периоде по графику работы.
//
// Параметры:
//  НачалоПериода - Дата - начало периода.
//  КонецПериода  - Дата - окончание периода.
//
// Возвращаемое значение:
//  Число - количество рабочих дней.
//
Функция РабочихДнейВПериоде(НачалоПериода, КонецПериода) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СУММА(График.Значение) КАК РабочихДней
		|ИЗ
		|	РегистрСведений.ВКМ_ГрафикРаботы КАК График
		|ГДЕ
		|	График.Дата МЕЖДУ &НачалоПериода И &КонецПериода";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Или Выборка.РабочихДней = Null Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Выборка.РабочихДней;
	
КонецФункции

#КонецОбласти
