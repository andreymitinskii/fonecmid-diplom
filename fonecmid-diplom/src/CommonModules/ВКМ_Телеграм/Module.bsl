#Область ПрограммныйИнтерфейс

// Отправляет сообщение в группу телеграм, указанную в константе
// "ВКМ_ИдентификаторГруппыТелеграм", от имени бота из константы
// "ВКМ_ТокенТелеграмБота".
//
// Параметры:
//  ТекстСообщения - Строка - текст, отправляемый в группу.
//
// Возвращаемое значение:
//  Булево - Истина, если сервис вернул код состояния 200.
//
Функция ОтправитьСообщение(ТекстСообщения) Экспорт
	
	Токен = Константы.ВКМ_ТокенТелеграмБота.Получить();
	ИдентификаторГруппы = Константы.ВКМ_ИдентификаторГруппыТелеграм.Получить();
	
	Если Не ЗначениеЗаполнено(Токен) Или Не ЗначениеЗаполнено(ИдентификаторГруппы) Тогда
		ЗаписатьОшибку(НСтр("ru = 'Не заполнены константы с токеном бота или идентификатором группы.'"));
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		Ответ = ВыполнитьЗапросКСервису(Токен, ИдентификаторГруппы, ТекстСообщения);
	Исключение
		ЗаписатьОшибку(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
	
	Если Ответ.КодСостояния = 200 Тогда
		Возврат Истина;
	КонецЕсли;
	
	ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Сервис вернул код состояния %1. Тело ответа: %2'"),
		Ответ.КодСостояния,
		Ответ.ТелоОтвета);
	ЗаписатьОшибку(ТекстОшибки);
	
	Возврат Ложь;
	
КонецФункции

// Помещает сообщение в очередь на отправку. Очередь обрабатывается
// регламентным заданием "ВКМ_ОтправкаУведомленийТелеграмБоту".
//
// Параметры:
//  ТекстСообщения - Строка - текст, который нужно отправить в группу.
//
Процедура ДобавитьУведомление(ТекстСообщения) Экспорт
	
	Если Не ЗначениеЗаполнено(ТекстСообщения) Тогда
		Возврат;
	КонецЕсли;
	
	Уведомление = Справочники.ВКМ_УведомленияТелеграмБотуДляОтправки.СоздатьЭлемент();
	Уведомление.ТекстСообщения = ТекстСообщения;
	Уведомление.Записать();
	
КонецПроцедуры

// Обработчик регламентного задания "ВКМ_ОтправкаУведомленийТелеграмБоту".
// Обходит очередь уведомлений, отправляет каждое сообщение и удаляет
// успешно отправленные элементы справочника.
//
Процедура ОтправитьНакопленныеУведомления() Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(
		Метаданные.РегламентныеЗадания.ВКМ_ОтправкаУведомленийТелеграмБоту);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Уведомления.Ссылка КАК Ссылка,
		|	Уведомления.ТекстСообщения КАК ТекстСообщения
		|ИЗ
		|	Справочник.ВКМ_УведомленияТелеграмБотуДляОтправки КАК Уведомления
		|УПОРЯДОЧИТЬ ПО
		|	Уведомления.Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Не ОтправитьСообщение(Выборка.ТекстСообщения) Тогда
			// Сообщение останется в очереди и будет отправлено при следующем запуске задания.
			Прервать;
		КонецЕсли;
		
		УдалитьУведомление(Выборка.Ссылка);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет POST-запрос к методу sendMessage сервиса api.telegram.org.
//
// Параметры:
//  Токен               - Строка - токен телеграм-бота.
//  ИдентификаторГруппы - Строка - идентификатор группы получателя.
//  ТекстСообщения      - Строка - текст сообщения.
//
// Возвращаемое значение:
//  Структура - результат обращения к сервису:
//   * КодСостояния - Число  - код состояния HTTP-ответа.
//   * ТелоОтвета   - Строка - тело ответа сервиса.
//
Функция ВыполнитьЗапросКСервису(Токен, ИдентификаторГруппы, ТекстСообщения)
	
	Соединение = Новый HTTPСоединение("api.telegram.org", , , , , 30, Новый ЗащищенноеСоединениеOpenSSL);
	
	Запрос = Новый HTTPЗапрос("/bot" + Токен + "/sendMessage");
	Запрос.Заголовки.Вставить("Content-Type", "application/json");
	Запрос.УстановитьТелоИзСтроки(ТелоЗапроса(ИдентификаторГруппы, ТекстСообщения));
	
	ОтветСервиса = Соединение.ОтправитьДляОбработки(Запрос);
	
	Результат = Новый Структура;
	Результат.Вставить("КодСостояния", ОтветСервиса.КодСостояния);
	Результат.Вставить("ТелоОтвета", ОтветСервиса.ПолучитьТелоКакСтроку());
	
	Возврат Результат;
	
КонецФункции

// Формирует тело запроса в формате JSON.
//
// Параметры:
//  ИдентификаторГруппы - Строка - идентификатор группы получателя.
//  ТекстСообщения      - Строка - текст сообщения.
//
// Возвращаемое значение:
//  Строка - JSON-представление параметров запроса.
//
Функция ТелоЗапроса(ИдентификаторГруппы, ТекстСообщения)
	
	ПараметрыСообщения = Новый Структура;
	ПараметрыСообщения.Вставить("chat_id", ИдентификаторГруппы);
	ПараметрыСообщения.Вставить("text", ТекстСообщения);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ПараметрыСообщения);
	
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

// Удаляет отправленное уведомление из очереди.
//
// Параметры:
//  Уведомление - СправочникСсылка.ВКМ_УведомленияТелеграмБотуДляОтправки - удаляемый элемент.
//
Процедура УдалитьУведомление(Уведомление)
	
	ОбъектУведомления = Уведомление.ПолучитьОбъект();
	Если ОбъектУведомления <> Неопределено Тогда
		ОбъектУведомления.Удалить();
	КонецЕсли;
	
КонецПроцедуры

// Записывает информацию об ошибке взаимодействия с телеграм-ботом в журнал регистрации.
//
// Параметры:
//  ТекстОшибки - Строка - описание возникшей ошибки.
//
Процедура ЗаписатьОшибку(ТекстОшибки)
	
	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'Оповещение специалистов через телеграм'", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти
