
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Для Каждого СтрокаОтпуска Из ОтпускаСотрудников Цикл
		
		Движение = Движения.ВКМ_ЗапланированныеОтпуска.Добавить();
		Движение.Период = СтрокаОтпуска.ДатаНачала;
		Движение.Сотрудник = СтрокаОтпуска.Сотрудник;
		Движение.ДнейОтпуска = ВКМ_ДнейОтпуска(СтрокаОтпуска);
		
	КонецЦикла;
	
	Движения.ВКМ_ЗапланированныеОтпуска.Записывать = Истина;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Для Каждого СтрокаОтпуска Из ОтпускаСотрудников Цикл
		
		Если СтрокаОтпуска.ДатаОкончания < СтрокаОтпуска.ДатаНачала Тогда
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'В строке %1 дата окончания отпуска раньше даты начала.'"),
				СтрокаОтпуска.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект,
				"ОтпускаСотрудников[" + (СтрокаОтпуска.НомерСтроки - 1) + "].ДатаОкончания",
				, Отказ);
		КонецЕсли;
		
		Если Год(СтрокаОтпуска.ДатаНачала) <> Год Тогда
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'В строке %1 отпуск начинается вне года графика.'"),
				СтрокаОтпуска.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект,
				"ОтпускаСотрудников[" + (СтрокаОтпуска.НомерСтроки - 1) + "].ДатаНачала",
				, Отказ);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает длительность отпуска в календарных днях, включая обе границы.
//
// Параметры:
//  СтрокаОтпуска - СтрокаТабличнойЧастиДокумента.ВКМ_ГрафикОтпусков.ОтпускаСотрудников - строка графика.
//
// Возвращаемое значение:
//  Число - количество календарных дней отпуска.
//
Функция ВКМ_ДнейОтпуска(СтрокаОтпуска)
	
	Если Не ЗначениеЗаполнено(СтрокаОтпуска.ДатаНачала)
		Или Не ЗначениеЗаполнено(СтрокаОтпуска.ДатаОкончания) Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Цел((НачалоДня(СтрокаОтпуска.ДатаОкончания)
		- НачалоДня(СтрокаОтпуска.ДатаНачала)) / 86400) + 1;
	
КонецФункции

#КонецОбласти

#КонецЕсли
