#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Параметры.АдресДанных) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Запланированные отпуска на %1 год'"), Формат(Параметры.Год, "ЧГ=0"));

	ПостроитьДиаграмму(ПолучитьИзВременногоХранилища(Параметры.АдресДанных));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Строит диаграмму Ганта по данным графика отпусков: точка - сотрудник,
// интервал - период его отпуска.
//
// Параметры:
//  ДанныеОтпусков - ТаблицаЗначений, Неопределено - строки графика отпусков
//                   с колонками Сотрудник, ДатаНачала, ДатаОкончания.
//
&НаСервере
Процедура ПостроитьДиаграмму(ДанныеОтпусков)

	// Перерисовка отключается на время заполнения и включается после него:
	// у диаграммы Ганта это свойство, а не метод обновления.
	ДиаграммаГанта.Обновление = Ложь;
	ДиаграммаГанта.Очистить();

	Если ТипЗнч(ДанныеОтпусков) <> Тип("ТаблицаЗначений") Тогда
		ДиаграммаГанта.Обновление = Истина;
		Возврат;
	КонецЕсли;

	Серия = ДиаграммаГанта.УстановитьСерию(НСтр("ru = 'Отпуск'"));

	НачалоИнтервала = '00010101';
	КонецИнтервала = '00010101';

	Для Каждого СтрокаОтпуска Из ДанныеОтпусков Цикл

		Если Не ЗначениеЗаполнено(СтрокаОтпуска.Сотрудник)
			Или Не ЗначениеЗаполнено(СтрокаОтпуска.ДатаНачала)
			Или Не ЗначениеЗаполнено(СтрокаОтпуска.ДатаОкончания) Тогда
			Продолжить;
		КонецЕсли;

		Начало = НачалоДня(СтрокаОтпуска.ДатаНачала);
		Окончание = КонецДня(СтрокаОтпуска.ДатаОкончания);

		Точка = ДиаграммаГанта.УстановитьТочку(СтрокаОтпуска.Сотрудник);

		ЗначениеДиаграммы = ДиаграммаГанта.ПолучитьЗначение(Точка, Серия);
		Интервал = ЗначениеДиаграммы.Добавить();
		Интервал.Начало = Начало;
		Интервал.Конец = Окончание;
		Интервал.Текст = Формат(СтрокаОтпуска.ДатаНачала, "ДЛФ=D")
			+ " - " + Формат(СтрокаОтпуска.ДатаОкончания, "ДЛФ=D");

		Если НачалоИнтервала = '00010101' Или Начало < НачалоИнтервала Тогда
			НачалоИнтервала = Начало;
		КонецЕсли;
		Если Окончание > КонецИнтервала Тогда
			КонецИнтервала = Окончание;
		КонецЕсли;

	КонецЦикла;

	// Автоопределение показывает текущий месяц, а отпуска запланированы на другие
	// месяцы года, поэтому видимый интервал задается явно по данным графика.
	// Границы интервала доступны только для чтения и устанавливаются методом.
	Если ЗначениеЗаполнено(НачалоИнтервала) Тогда
		ДиаграммаГанта.АвтоОпределениеПолногоИнтервала = Ложь;
		ДиаграммаГанта.УстановитьПолныйИнтервал(
			НачалоМесяца(НачалоИнтервала), КонецМесяца(КонецИнтервала));
	КонецЕсли;

	ДиаграммаГанта.Обновление = Истина;

КонецПроцедуры

#КонецОбласти
