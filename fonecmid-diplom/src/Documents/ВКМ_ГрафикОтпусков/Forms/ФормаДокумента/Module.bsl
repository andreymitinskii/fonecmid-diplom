#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Объект.Год) Тогда
		Объект.Год = Год(ТекущаяДатаСеанса()) + 1;
	КонецЕсли;

	НастроитьПодсветкуПревышения();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура АнализГрафика(Команда)

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("АдресДанных", ПоместитьДанныеГрафика());
	ПараметрыФормы.Вставить("Год", Объект.Год);

	ОткрытьФорму("Документ.ВКМ_ГрафикОтпусков.Форма.АнализГрафика",
		ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Помещает строки графика во временное хранилище для формы анализа.
// Передача данных между формами выполняется через временное хранилище.
//
// Возвращаемое значение:
//  Строка - адрес данных во временном хранилище.
//
&НаСервере
Функция ПоместитьДанныеГрафика()

	ДанныеОтпусков = Объект.ОтпускаСотрудников.Выгрузить(,
		"Сотрудник, ДатаНачала, ДатаОкончания");

	Возврат ПоместитьВоВременноеХранилище(ДанныеОтпусков, УникальныйИдентификатор);

КонецФункции

// Настраивает условное оформление таблицы: строки сотрудников, у которых
// суммарная длительность отпуска превышает 28 календарных дней, выделяются цветом.
//
&НаСервере
Процедура НастроитьПодсветкуПревышения()

	СотрудникиСПревышениемЛимита = СотрудникиСПревышением();
	Если СотрудникиСПревышениемЛимита.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// У элемента условного оформления нет свойства Имя, найти ранее созданный
	// элемент по имени невозможно. Процедура вызывается один раз при создании
	// формы, поэтому элемент просто создается заново.
	Оформление = УсловноеОформление.Элементы.Добавить();

	ПолеОформления = Оформление.Поля.Элементы.Добавить();
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("ОтпускаСотрудников");

	// Цвет задается явно: подходящего элемента стиля в конфигурации нет.
	Оформление.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(255, 225, 225));

	ЭлементОтбора = Оформление.Отбор.Элементы.Добавить(
		Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(
		"Объект.ОтпускаСотрудников.Сотрудник");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	ЭлементОтбора.ПравоеЗначение = СотрудникиСПревышениемЛимита;

КонецПроцедуры

// Возвращает сотрудников, суммарная длительность отпусков которых
// в графике превышает 28 календарных дней.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.ВКМ_Сотрудники - сотрудники с превышением.
//
&НаСервере
Функция СотрудникиСПревышением()

	ДлительностьПоСотрудникам = Новый Соответствие;

	Для Каждого СтрокаОтпуска Из Объект.ОтпускаСотрудников Цикл

		Если Не ЗначениеЗаполнено(СтрокаОтпуска.ДатаНачала)
			Или Не ЗначениеЗаполнено(СтрокаОтпуска.ДатаОкончания) Тогда
			Продолжить;
		КонецЕсли;

		Дней = Цел((НачалоДня(СтрокаОтпуска.ДатаОкончания)
			- НачалоДня(СтрокаОтпуска.ДатаНачала)) / 86400) + 1;

		Текущее = ДлительностьПоСотрудникам.Получить(СтрокаОтпуска.Сотрудник);
		ДлительностьПоСотрудникам.Вставить(СтрокаОтпуска.Сотрудник,
			?(Текущее = Неопределено, 0, Текущее) + Дней);

	КонецЦикла;

	Результат = Новый Массив;
	Для Каждого КлючИЗначение Из ДлительностьПоСотрудникам Цикл
		Если КлючИЗначение.Значение > 28 Тогда
			Результат.Добавить(КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
