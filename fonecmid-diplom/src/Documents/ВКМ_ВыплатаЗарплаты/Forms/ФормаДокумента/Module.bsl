#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)

	ЗаполнитьПоОстаткамНаСервере();

	Если Объект.Выплаты.Количество() = 0 Тогда
		ПоказатьПредупреждение(,
			НСтр("ru = 'Задолженность перед сотрудниками на дату документа отсутствует.'"));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет таблицу выплат остатками взаиморасчетов на дату документа.
//
&НаСервере
Процедура ЗаполнитьПоОстаткамНаСервере()

	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ВКМ_ЗаполнитьПоОстаткам();
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");

КонецПроцедуры

#КонецОбласти
