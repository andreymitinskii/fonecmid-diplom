
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПериодНачала = НачалоМесяца(ПериодРегистрации);
	
	// Премия регистрируется как дополнительное начисление, НДФЛ - как удержание
	// от суммы премий именно этого документа: иначе при нескольких документах
	// за месяц налог был бы удержан повторно с одной и той же базы.
	Для Каждого СтрокаПремии Из СписокСотрудников Цикл
		
		Если СтрокаПремии.СуммаПремии = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Начисление = Движения.ВКМ_ДополнительныеНачисления.Добавить();
		Начисление.ПериодРегистрации = ПериодНачала;
		Начисление.ВидРасчета = ПланыВидовРасчета.ВКМ_ДополнительныеНачисления.ФиксированнаяПремия;
		Начисление.Сотрудник = СтрокаПремии.Сотрудник;
		Начисление.Результат = СтрокаПремии.СуммаПремии;
		
		Удержание = Движения.ВКМ_Удержания.Добавить();
		Удержание.ПериодРегистрации = ПериодНачала;
		Удержание.ВидРасчета = ПланыВидовРасчета.ВКМ_Удержания.НДФЛ;
		Удержание.Сотрудник = СтрокаПремии.Сотрудник;
		Удержание.Результат = ВКМ_РасчетЗарплаты.РассчитатьНДФЛ(СтрокаПремии.СуммаПремии);
		
		Взаиморасчеты = Движения.ВКМ_ВзаиморасчетыССотрудниками.Добавить();
		Взаиморасчеты.ВидДвижения = ВидДвиженияНакопления.Приход;
		Взаиморасчеты.Период = Дата;
		Взаиморасчеты.Сотрудник = СтрокаПремии.Сотрудник;
		Взаиморасчеты.Сумма = СтрокаПремии.СуммаПремии
			- ВКМ_РасчетЗарплаты.РассчитатьНДФЛ(СтрокаПремии.СуммаПремии);
		
	КонецЦикла;
	
	Движения.ВКМ_ДополнительныеНачисления.Записывать = Истина;
	Движения.ВКМ_Удержания.Записывать = Истина;
	Движения.ВКМ_ВзаиморасчетыССотрудниками.Записывать = Истина;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
