
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОписаниеПеременных

// Признак того, что после записи документа нужно оповестить специалистов
// через телеграм-бота. Устанавливается в обработчике ПередЗаписью.
Перем ВКМ_ТребуетсяОповещение;

// Признак того, что документ записывается впервые. Запоминается до записи,
// так как в обработчике ПриЗаписи метод ЭтоНовый уже возвращает Ложь.
Перем ВКМ_ЭтоНоваяЗаявка;

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ВКМ_ЭтоНоваяЗаявка = ЭтоНовый();
	ВКМ_ТребуетсяОповещение = ВКМ_ПланированиеИзменилось();
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Или Не ВКМ_ТребуетсяОповещение Тогда
		Возврат;
	КонецЕсли;
	
	ВКМ_Телеграм.ДобавитьУведомление(ВКМ_ТекстОповещения());
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ДанныеДоговора = ВКМ_ДанныеДоговора();
	
	Если Не ВКМ_ДоговорКорректен(ДанныеДоговора, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	ВКМ_СформироватьДвиженияПоВыполненнымРаботам(ДанныеДоговора.СтоимостьЧасаРаботы);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ВремяОкончанияПлан <> '00010101' И ВремяНачалаПлан > ВремяОкончанияПлан Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Время окончания работ не может быть раньше времени начала работ.'"),
			ЭтотОбъект,
			"ВремяОкончанияПлан",
			,
			Отказ);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает условия договора, указанного в документе.
//
// Возвращаемое значение:
//  Структура - условия договора:
//   * ВидДоговора             - ПеречислениеСсылка.ВидыДоговоровКонтрагентов - вид договора.
//   * ДатаНачала              - Дата   - дата начала действия договора.
//   * ДатаОкончания           - Дата   - дата окончания действия договора.
//   * СтоимостьЧасаРаботы     - Число  - стоимость часа работы специалиста.
//
Функция ВКМ_ДанныеДоговора()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ДоговорыКонтрагентов.ВидДоговора КАК ВидДоговора,
		|	ДоговорыКонтрагентов.ВКМ_ДатаНачала КАК ДатаНачала,
		|	ДоговорыКонтрагентов.ВКМ_ДатаОкончания КАК ДатаОкончания,
		|	ДоговорыКонтрагентов.ВКМ_СтоимостьЧасаРаботы КАК СтоимостьЧасаРаботы
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.Ссылка = &Договор";
	Запрос.УстановитьПараметр("Договор", Договор);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ВидДоговора", Выборка.ВидДоговора);
	Результат.Вставить("ДатаНачала", Выборка.ДатаНачала);
	Результат.Вставить("ДатаОкончания", Выборка.ДатаОкончания);
	Результат.Вставить("СтоимостьЧасаРаботы", Выборка.СтоимостьЧасаРаботы);
	
	Возврат Результат;
	
КонецФункции

// Проверяет, что указан договор абонентского обслуживания и дата документа
// попадает в период действия этого договора.
//
// Параметры:
//  ДанныеДоговора - Структура, Неопределено - условия договора, см. ВКМ_ДанныеДоговора.
//  Отказ          - Булево - признак отказа от проведения, устанавливается при ошибке.
//
// Возвращаемое значение:
//  Булево - Истина, если договор пригоден для проведения документа.
//
Функция ВКМ_ДоговорКорректен(ДанныеДоговора, Отказ)
	
	Если ДанныеДоговора = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Не удалось получить условия договора.'"), ЭтотОбъект, "Договор", , Отказ);
		Возврат Ложь;
	КонецЕсли;
	
	Если ДанныеДоговора.ВидДоговора
		<> Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание Тогда
		
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Обслуживание клиента можно провести только по договору
			           |вида «Абонентское обслуживание».'"),
			ЭтотОбъект, "Договор", , Отказ);
		Возврат Ложь;
	КонецЕсли;
	
	ДатаДокумента = НачалоДня(Дата);
	
	Если ДатаДокумента < НачалоДня(ДанныеДоговора.ДатаНачала)
		Или ДатаДокумента > КонецДня(ДанныеДоговора.ДатаОкончания) Тогда
		
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Дата документа не входит в период действия договора (с %1 по %2).'"),
			Формат(ДанныеДоговора.ДатаНачала, "ДЛФ=D"),
			Формат(ДанныеДоговора.ДатаОкончания, "ДЛФ=D"));
		
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "Дата", , Отказ);
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Формирует движения по регистру накопления "ВКМ_ВыполненныеКлиентуРаботы".
// Сумма к оплате рассчитывается по ставке часа, указанной в договоре.
//
// Параметры:
//  СтоимостьЧасаРаботы - Число - ставка часа работы специалиста из договора.
//
Процедура ВКМ_СформироватьДвиженияПоВыполненнымРаботам(СтоимостьЧасаРаботы)
	
	ЧасовВсего = ВыполненныеРаботы.Итог("ЧасыКОплатеКлиенту");
	Если ЧасовВсего = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Движение = Движения.ВКМ_ВыполненныеКлиентуРаботы.Добавить();
	Движение.Период = Дата;
	Движение.Клиент = Клиент;
	Движение.Договор = Договор;
	Движение.КоличествоЧасов = ЧасовВсего;
	Движение.СуммаКОплате = ЧасовВсего * СтоимостьЧасаРаботы;
	
	Движения.ВКМ_ВыполненныеКлиентуРаботы.Записывать = Истина;
	
КонецПроцедуры


// Определяет, изменились ли параметры планирования заявки: дата проведения работ,
// плановое время или назначенный специалист. Для нового документа всегда Истина.
//
// Возвращаемое значение:
//  Булево - Истина, если специалистов нужно оповестить.
//
Функция ВКМ_ПланированиеИзменилось()
	
	Если ЭтоНовый() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Обслуживание.Специалист КАК Специалист,
		|	Обслуживание.ДатаПроведенияРабот КАК ДатаПроведенияРабот,
		|	Обслуживание.ВремяНачалаПлан КАК ВремяНачалаПлан,
		|	Обслуживание.ВремяОкончанияПлан КАК ВремяОкончанияПлан
		|ИЗ
		|	Документ.ВКМ_ОбслуживаниеКлиента КАК Обслуживание
		|ГДЕ
		|	Обслуживание.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Выборка.Специалист <> Специалист
		Или Выборка.ДатаПроведенияРабот <> ДатаПроведенияРабот
		Или Выборка.ВремяНачалаПлан <> ВремяНачалаПлан
		Или Выборка.ВремяОкончанияПлан <> ВремяОкончанияПлан;
	
КонецФункции

// Формирует текст оповещения о запланированной заявке.
//
// Возвращаемое значение:
//  Строка - текст сообщения для отправки в группу телеграм.
//
Функция ВКМ_ТекстОповещения()
	
	Шаблон = ?(ВКМ_ЭтоНоваяЗаявка,
		НСтр("ru = 'Новая заявка %1 от %2.
		           |Клиент: %3.
		           |Специалист: %4.
		           |Дата работ: %5, с %6 до %7.
		           |Проблема: %8'"),
		НСтр("ru = 'Изменена заявка %1 от %2.
		           |Клиент: %3.
		           |Специалист: %4.
		           |Дата работ: %5, с %6 до %7.
		           |Проблема: %8'"));
	
	Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,
		Номер,
		Формат(Дата, "ДЛФ=D"),
		Строка(Клиент),
		Строка(Специалист),
		Формат(ДатаПроведенияРабот, "ДЛФ=D"),
		Формат(ВремяНачалаПлан, "ДФ=ЧЧ:мм"),
		Формат(ВремяОкончанияПлан, "ДФ=ЧЧ:мм"),
		ОписаниеПроблемы);
	
КонецФункции

#КонецОбласти

#КонецЕсли
