
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	НачалоРасчета = НачалоМесяца(ПериодРегистрации);
	КонецРасчета = КонецМесяца(ПериодРегистрации);

	Данные = ВКМ_ДанныеДляРасчета(НачалоРасчета, КонецРасчета);

	ВКМ_НачислитьОклад(Данные, НачалоРасчета, КонецРасчета);
	ВКМ_НачислитьОтпуска(Данные, НачалоРасчета, КонецРасчета);
	ВКМ_НачислитьПроцентОтРабот(Данные, НачалоРасчета);
	ВКМ_УдержатьНДФЛ(НачалоРасчета);
	ВКМ_СформироватьВзаиморасчеты();

	Движения.ВКМ_ОсновныеНачисления.Записывать = Истина;
	Движения.ВКМ_ДополнительныеНачисления.Записывать = Истина;
	Движения.ВКМ_Удержания.Записывать = Истина;
	Движения.ВКМ_ВзаиморасчетыССотрудниками.Записывать = Истина;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Получает исходные данные расчета одним пакетным запросом: условия оплаты,
// плановые отпуска месяца, выполненные работы и базу среднего заработка.
//
// Параметры:
//  НачалоРасчета - Дата - начало расчетного месяца.
//  КонецРасчета  - Дата - конец расчетного месяца.
//
// Возвращаемое значение:
//  Структура - исходные данные расчета:
//   * Сотрудники - ТаблицаЗначений - условия оплаты сотрудников.
//   * Отпуска    - ТаблицаЗначений - отпуска, пересекающиеся с месяцем расчета.
//   * Работы     - ТаблицаЗначений - выполненные работы специалистов за месяц.
//   * База       - ТаблицаЗначений - начисления за 12 предшествующих месяцев.
//
Функция ВКМ_ДанныеДляРасчета(НачалоРасчета, КонецРасчета)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Условия.Сотрудник КАК Сотрудник,
		|	Условия.Оклад КАК Оклад,
		|	Условия.ПроцентОтРабот КАК ПроцентОтРабот
		|ИЗ
		|	РегистрСведений.ВКМ_УсловияОплатыСотрудников.СрезПоследних(&КонецРасчета, ) КАК Условия
		|;
		|ВЫБРАТЬ
		|	Отпуска.Сотрудник КАК Сотрудник,
		|	Отпуска.Период КАК ДатаНачала,
		|	ДОБАВИТЬКДАТЕ(Отпуска.Период, ДЕНЬ, Отпуска.ДнейОтпускаОборот - 1) КАК ДатаОкончания,
		|	Отпуска.ДнейОтпускаОборот КАК КалендарныхДней
		|ПОМЕСТИТЬ ОтпускаПериода
		|ИЗ
		|	РегистрНакопления.ВКМ_ЗапланированныеОтпуска.Обороты(
		|			ДОБАВИТЬКДАТЕ(&НачалоРасчета, МЕСЯЦ, -2),
		|			&КонецРасчета,
		|			Регистратор,
		|			) КАК Отпуска
		|ГДЕ
		|	Отпуска.ДнейОтпускаОборот > 0
		|;
		|ВЫБРАТЬ
		|	ОтпускаПериода.Сотрудник КАК Сотрудник,
		|	ОтпускаПериода.ДатаНачала КАК ДатаНачала,
		|	ОтпускаПериода.ДатаОкончания КАК ДатаОкончания,
		|	ОтпускаПериода.КалендарныхДней КАК КалендарныхДней,
		|	ЕСТЬNULL(СУММА(График.Значение), 0) КАК РабочихДнейОтпуска
		|ИЗ
		|	ОтпускаПериода КАК ОтпускаПериода
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВКМ_ГрафикРаботы КАК График
		|		ПО График.Дата МЕЖДУ ОтпускаПериода.ДатаНачала И ОтпускаПериода.ДатаОкончания
		|			И График.Дата МЕЖДУ &НачалоРасчета И &КонецРасчета
		|ГДЕ
		|	ОтпускаПериода.ДатаОкончания >= &НачалоРасчета
		|	И ОтпускаПериода.ДатаНачала <= &КонецРасчета
		|СГРУППИРОВАТЬ ПО
		|	ОтпускаПериода.Сотрудник,
		|	ОтпускаПериода.ДатаНачала,
		|	ОтпускаПериода.ДатаОкончания,
		|	ОтпускаПериода.КалендарныхДней
		|;
		|ВЫБРАТЬ
		|	Работы.Сотрудник КАК Сотрудник,
		|	Работы.СуммаКОплатеОборот КАК СуммаКОплате
		|ИЗ
		|	РегистрНакопления.ВКМ_ВыполненныеСотрудникомРаботы.Обороты(
		|			&НачалоРасчета,
		|			&КонецРасчета,
		|			Регистратор,
		|			) КАК Работы
		|ГДЕ
		|	Работы.СуммаКОплатеОборот <> 0
		|;
		|ВЫБРАТЬ
		|	Начисления.Сотрудник КАК Сотрудник,
		|	СУММА(Начисления.Результат) КАК СуммаНачислений
		|ИЗ
		|	(ВЫБРАТЬ
		|		Основные.Сотрудник КАК Сотрудник,
		|		Основные.Результат КАК Результат
		|	ИЗ
		|		РегистрРасчета.ВКМ_ОсновныеНачисления КАК Основные
		|	ГДЕ
		|		Основные.ПериодРегистрации МЕЖДУ &НачалоБазы И &КонецБазы
		|
		|	ОБЪЕДИНИТЬ ВСЕ
		|
		|	ВЫБРАТЬ
		|		Дополнительные.Сотрудник,
		|		Дополнительные.Результат
		|	ИЗ
		|		РегистрРасчета.ВКМ_ДополнительныеНачисления КАК Дополнительные
		|	ГДЕ
		|		Дополнительные.ПериодРегистрации МЕЖДУ &НачалоБазы И &КонецБазы) КАК Начисления
		|СГРУППИРОВАТЬ ПО
		|	Начисления.Сотрудник";

	Запрос.УстановитьПараметр("НачалоРасчета", НачалоРасчета);
	Запрос.УстановитьПараметр("КонецРасчета", КонецРасчета);
	Запрос.УстановитьПараметр("НачалоБазы", ДобавитьМесяц(НачалоРасчета, -12));
	Запрос.УстановитьПараметр("КонецБазы", КонецМесяца(ДобавитьМесяц(НачалоРасчета, -1)));

	Результаты = Запрос.ВыполнитьПакет();

	Данные = Новый Структура;
	Данные.Вставить("Сотрудники", Результаты[0].Выгрузить());
	Данные.Вставить("Отпуска", Результаты[2].Выгрузить());
	Данные.Вставить("Работы", Результаты[3].Выгрузить());
	Данные.Вставить("База", Результаты[4].Выгрузить());

	Возврат Данные;

КонецФункции

// Начисляет оклад пропорционально отработанным рабочим дням месяца.
// Рабочие дни, попавшие в отпуск, из нормы исключаются: это соответствует
// вытеснению оклада отпуском, заданному в плане видов расчета.
//
// Параметры:
//  Данные        - см. ВКМ_ДанныеДляРасчета
//  НачалоРасчета - Дата - начало расчетного месяца.
//  КонецРасчета  - Дата - конец расчетного месяца.
//
Процедура ВКМ_НачислитьОклад(Данные, НачалоРасчета, КонецРасчета)

	НормаДней = ВКМ_РасчетЗарплаты.РабочихДнейВПериоде(НачалоРасчета, КонецРасчета);
	Если НормаДней = 0 Тогда
		Возврат;
	КонецЕсли;

	ОтпускаПоСотрудникам = Данные.Отпуска.Скопировать();
	ОтпускаПоСотрудникам.Свернуть("Сотрудник", "РабочихДнейОтпуска");

	Для Каждого СтрокаУсловий Из Данные.Сотрудники Цикл

		Если СтрокаУсловий.Оклад = 0 Тогда
			Продолжить;
		КонецЕсли;

		НайденныеОтпуска = ОтпускаПоСотрудникам.НайтиСтроки(
			Новый Структура("Сотрудник", СтрокаУсловий.Сотрудник));
		ДнейОтпуска = ?(НайденныеОтпуска.Количество() > 0,
			НайденныеОтпуска[0].РабочихДнейОтпуска, 0);

		ОтработаноДней = НормаДней - ДнейОтпуска;
		Если ОтработаноДней <= 0 Тогда
			Продолжить;
		КонецЕсли;

		Начисление = Движения.ВКМ_ОсновныеНачисления.Добавить();
		Начисление.ПериодРегистрации = НачалоРасчета;
		Начисление.ПериодДействияНачало = НачалоРасчета;
		Начисление.ПериодДействияКонец = КонецРасчета;
		Начисление.ВидРасчета = ПланыВидовРасчета.ВКМ_ОсновныеНачисления.Оклад;
		Начисление.Сотрудник = СтрокаУсловий.Сотрудник;
		Начисление.Результат = Окр(СтрокаУсловий.Оклад * ОтработаноДней / НормаДней, 2);

	КонецЦикла;

КонецПроцедуры

// Начисляет отпускные по среднедневному заработку за 12 месяцев,
// предшествующих месяцу расчета.
//
// Параметры:
//  Данные        - см. ВКМ_ДанныеДляРасчета
//  НачалоРасчета - Дата - начало расчетного месяца.
//  КонецРасчета  - Дата - конец расчетного месяца.
//
Процедура ВКМ_НачислитьОтпуска(Данные, НачалоРасчета, КонецРасчета)

	РабочихДнейБазы = ВКМ_РасчетЗарплаты.РабочихДнейВПериоде(
		ДобавитьМесяц(НачалоРасчета, -12), КонецМесяца(ДобавитьМесяц(НачалоРасчета, -1)));

	Для Каждого СтрокаОтпуска Из Данные.Отпуска Цикл

		НайденнаяБаза = Данные.База.НайтиСтроки(
			Новый Структура("Сотрудник", СтрокаОтпуска.Сотрудник));
		СуммаБазы = ?(НайденнаяБаза.Количество() > 0, НайденнаяБаза[0].СуммаНачислений, 0);

		Если СуммаБазы = 0 Или РабочихДнейБазы = 0 Тогда
			// Отработанного периода нет, среднедневной заработок рассчитать не из чего.
			Продолжить;
		КонецЕсли;

		Среднедневной = СуммаБазы / РабочихДнейБазы;

		Начисление = Движения.ВКМ_ОсновныеНачисления.Добавить();
		Начисление.ПериодРегистрации = НачалоРасчета;
		Начисление.ПериодДействияНачало = Макс(СтрокаОтпуска.ДатаНачала, НачалоРасчета);
		Начисление.ПериодДействияКонец = Мин(КонецДня(СтрокаОтпуска.ДатаОкончания), КонецРасчета);
		Начисление.ВидРасчета = ПланыВидовРасчета.ВКМ_ОсновныеНачисления.Отпуск;
		Начисление.Сотрудник = СтрокаОтпуска.Сотрудник;
		Начисление.Результат = Окр(Среднедневной * СтрокаОтпуска.КалендарныхДней, 2);

	КонецЦикла;

КонецПроцедуры

// Начисляет специалистам процент от выполненных работ. Сумма уже рассчитана
// документами обслуживания с учетом процента, установленного сотруднику.
//
// Параметры:
//  Данные        - см. ВКМ_ДанныеДляРасчета
//  НачалоРасчета - Дата - начало расчетного месяца.
//
Процедура ВКМ_НачислитьПроцентОтРабот(Данные, НачалоРасчета)

	Для Каждого СтрокаРабот Из Данные.Работы Цикл

		Начисление = Движения.ВКМ_ДополнительныеНачисления.Добавить();
		Начисление.ПериодРегистрации = НачалоРасчета;
		Начисление.ВидРасчета =
			ПланыВидовРасчета.ВКМ_ДополнительныеНачисления.ПроцентОтВыполненныхРабот;
		Начисление.Сотрудник = СтрокаРабот.Сотрудник;
		Начисление.Результат = СтрокаРабот.СуммаКОплате;

	КонецЦикла;

КонецПроцедуры

// Удерживает НДФЛ с начислений, зарегистрированных этим документом.
//
// Параметры:
//  НачалоРасчета - Дата - начало расчетного месяца.
//
Процедура ВКМ_УдержатьНДФЛ(НачалоРасчета)

	НачисленоПоСотрудникам = ВКМ_НачисленоПоСотрудникам();

	Для Каждого СтрокаНачислений Из НачисленоПоСотрудникам Цикл

		СуммаНДФЛ = ВКМ_РасчетЗарплаты.РассчитатьНДФЛ(СтрокаНачислений.Значение);
		Если СуммаНДФЛ = 0 Тогда
			Продолжить;
		КонецЕсли;

		Удержание = Движения.ВКМ_Удержания.Добавить();
		Удержание.ПериодРегистрации = НачалоРасчета;
		Удержание.ВидРасчета = ПланыВидовРасчета.ВКМ_Удержания.НДФЛ;
		Удержание.Сотрудник = СтрокаНачислений.Ключ;
		Удержание.Результат = СуммаНДФЛ;

	КонецЦикла;

КонецПроцедуры

// Формирует движения по взаиморасчетам с сотрудниками:
// начислено этим документом минус удержано этим же документом.
//
Процедура ВКМ_СформироватьВзаиморасчеты()

	НачисленоПоСотрудникам = ВКМ_НачисленоПоСотрудникам();

	УдержаноПоСотрудникам = Новый Соответствие;
	Для Каждого Удержание Из Движения.ВКМ_Удержания Цикл
		Текущее = УдержаноПоСотрудникам.Получить(Удержание.Сотрудник);
		УдержаноПоСотрудникам.Вставить(Удержание.Сотрудник,
			?(Текущее = Неопределено, 0, Текущее) + Удержание.Результат);
	КонецЦикла;

	Для Каждого СтрокаНачислений Из НачисленоПоСотрудникам Цикл

		Удержано = УдержаноПоСотрудникам.Получить(СтрокаНачислений.Ключ);
		Сумма = СтрокаНачислений.Значение - ?(Удержано = Неопределено, 0, Удержано);

		Если Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;

		Взаиморасчеты = Движения.ВКМ_ВзаиморасчетыССотрудниками.Добавить();
		Взаиморасчеты.ВидДвижения = ВидДвиженияНакопления.Приход;
		Взаиморасчеты.Период = Дата;
		Взаиморасчеты.Сотрудник = СтрокаНачислений.Ключ;
		Взаиморасчеты.Сумма = Сумма;

	КонецЦикла;

КонецПроцедуры

// Собирает начисленные этим документом суммы в разрезе сотрудников.
//
// Возвращаемое значение:
//  Соответствие - ключ: СправочникСсылка.ВКМ_Сотрудники, значение: Число.
//
Функция ВКМ_НачисленоПоСотрудникам()

	Результат = Новый Соответствие;

	Для Каждого Начисление Из Движения.ВКМ_ОсновныеНачисления Цикл
		Текущее = Результат.Получить(Начисление.Сотрудник);
		Результат.Вставить(Начисление.Сотрудник,
			?(Текущее = Неопределено, 0, Текущее) + Начисление.Результат);
	КонецЦикла;

	Для Каждого Начисление Из Движения.ВКМ_ДополнительныеНачисления Цикл
		Текущее = Результат.Получить(Начисление.Сотрудник);
		Результат.Вставить(Начисление.Сотрудник,
			?(Текущее = Неопределено, 0, Текущее) + Начисление.Результат);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецЕсли
