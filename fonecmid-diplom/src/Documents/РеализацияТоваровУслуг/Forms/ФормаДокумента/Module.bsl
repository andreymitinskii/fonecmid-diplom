КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

#КонецОбласти

#Область ВКМ_Автозаполнение

// ВКМ_ Начало: команда заполнения по договору абонентского обслуживания

// Программно добавляет на форму команду "Заполнить" и кнопку в командной панели формы.
//
&НаСервере
Процедура ВКМ_ДобавитьКомандуЗаполнения()
	
	Команда = Команды.Добавить("ВКМ_Заполнить");
	Команда.Действие = "ВКМ_Заполнить";
	Команда.Заголовок = НСтр("ru = 'Заполнить'");
	Команда.Подсказка = НСтр("ru = 'Заполнить услуги по договору абонентского обслуживания'");
	
	Кнопка = Элементы.Добавить("ВКМ_ЗаполнитьКнопка", Тип("КнопкаФормы"), Элементы.ФормаКоманднаяПанель);
	Кнопка.ИмяКоманды = "ВКМ_Заполнить";
	
КонецПроцедуры

// Обработчик команды "Заполнить".
//
// Параметры:
//  Команда - КомандаФормы - выполняемая команда.
//
&НаКлиенте
Процедура ВКМ_Заполнить(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Договор) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Для заполнения укажите договор.'"));
		Возврат;
	КонецЕсли;
	
	ВКМ_ЗаполнитьНаСервере();
	
КонецПроцедуры

// Проверяет вид договора и вызывает автозаполнение в модуле объекта документа.
//
&НаСервере
Процедура ВКМ_ЗаполнитьНаСервере()
	
	ВидДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор, "ВидДоговора");
	
	Если ВидДоговора <> Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Автозаполнение доступно только для договоров вида «Абонентское обслуживание».'"),
			,
			"Объект.Договор");
		Возврат;
	КонецЕсли;
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ВКМ_ВыполнитьАвтозаполнение();
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
КонецПроцедуры

// ВКМ_ Конец: команда заполнения по договору абонентского обслуживания

#КонецОбласти

#КонецОбласти
